# Mundi.ai Local Development Configuration
# Copy this file to .env and configure your settings

# ===========================================
# LLM Configuration (Choose one option)
# ===========================================

# Option 1: OpenAI API (Recommended for full features)
# Uncomment and add your OpenAI API key
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini  # or gpt-4o for better results

# Option 2: Ollama (Local LLM)
# First install Ollama: https://ollama.com
# Then pull a model: ollama pull llama3.2
# Uncomment these lines to use Ollama
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.2

# Option 3: Any OpenAI-compatible API
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=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
OPENAI_MODEL=z-ai/glm-4.5

# ===========================================
# Authentication Mode
# ===========================================
MUNDI_AUTH_MODE=edit  # "edit" for full access, "view_only" for read-only

# ===========================================
# Service URLs (Usually no changes needed)
# ===========================================
WEBSITE_DOMAIN=http://localhost:8000
VITE_WEBSITE_DOMAIN=http://localhost:8000
VITE_EMAIL_VERIFICATION=disable

# ===========================================
# Database Configuration (Docker defaults)
# ===========================================
POSTGRES_HOST=postgresdb
POSTGRES_PORT=5432
POSTGRES_DB=mundidb
POSTGRES_USER=mundiuser
POSTGRES_PASSWORD=gdalpassword

# ===========================================
# S3/MinIO Configuration (Docker defaults)
# ===========================================
S3_ACCESS_KEY_ID=s3user
S3_SECRET_ACCESS_KEY=backup123
S3_DEFAULT_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=test-bucket

# ===========================================
# Other Services (Docker defaults)
# ===========================================
DRIFTDB_SERVER_URL=http://driftdb:8080
QGIS_PROCESSING_URL=http://qgis-processing:8817
REDIS_HOST=redis
REDIS_PORT=6379

# ===========================================
# PostGIS Docker Network Policy
# ===========================================
POSTGIS_LOCALHOST_POLICY=docker_rewrite

# ===========================================
# Python Settings
# ===========================================
PYTHONUNBUFFERED=1
PYTHONIOENCODING=utf-8
